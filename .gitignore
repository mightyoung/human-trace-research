# 日志与临时文件
*.log
/tmp/
*.pdf
*.tmp
*.bak
*.bak_*
*.orig
*.rej
tmp${f}.png

# 同步冲突副本（Syncthing 产生）
*.sync-conflict-*

# 打包快照（代码副本，避免与源码双份维护）
/research_package/
/handoff_out/
# 外部工具产出的历史草稿归档（500+ patch 文件，非本项目核心代码）
/docs/commit-015/

# 验证集的原始检测/嵌入中间层（保留 results/ 下的 CSV 汇总）
/validation/mars/

