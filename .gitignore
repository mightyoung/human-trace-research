# ---------------------------------------------------------------------------
# 7. 显式保留（放在最后，覆盖上面的忽略规则）
# ---------------------------------------------------------------------------
# 论文 PDF 是交付物，不是影像材料
!docs/paper/tbiom-r3/main.pdf
!docs/paper/tbiom-r3/supplement.pdf
# 本轮复算脚本产出的派生结果（无影像）
!/tmp/derived/
!/tmp/derived/*.py
!/tmp/derived/*.json
!/tmp/derived/*.csv
# 工作台账数据库（表结构 + 证据，2 MB）
!/ops/ops.db
